# Sudoers configuration for distiller-cm5-python
# This file allows the distiller user to manage network connections
# and perform system operations required by the Distiller CM5 Python application

# Comprehensive NetworkManager operations for WiFi service
distiller ALL=(ALL) NOPASSWD: /usr/bin/nmcli
distiller ALL=(ALL) NOPASSWD: /usr/bin/nmcli *

# Service management for networking and system services
distiller ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart avahi-daemon
distiller ALL=(ALL) NOPASSWD: /usr/bin/systemctl reload avahi-daemon
distiller ALL=(ALL) NOPASSWD: /usr/bin/systemctl start NetworkManager
distiller ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart NetworkManager
distiller ALL=(ALL) NOPASSWD: /bin/systemctl restart networking
distiller ALL=(ALL) NOPASSWD: /bin/systemctl restart NetworkManager

# Network interface information and management
distiller ALL=(ALL) NOPASSWD: /usr/bin/ip addr show*
distiller ALL=(ALL) NOPASSWD: /usr/bin/ip link show*
distiller ALL=(ALL) NOPASSWD: /usr/bin/iwgetid*

# Hostname management for WiFi service
distiller ALL=(ALL) NOPASSWD: /usr/bin/hostname
distiller ALL=(ALL) NOPASSWD: /usr/bin/hostnamectl*
distiller ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/hostname
distiller ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/hosts
distiller ALL=(ALL) NOPASSWD: /bin/tee /etc/hosts
distiller ALL=(ALL) NOPASSWD: /usr/bin/cp /etc/hosts /etc/hosts.backup.*
distiller ALL=(ALL) NOPASSWD: /usr/bin/cat /etc/hosts
distiller ALL=(ALL) NOPASSWD: /bin/hostname
distiller ALL=(ALL) NOPASSWD: /bin/cp /etc/hosts /etc/hosts.backup.*
distiller ALL=(ALL) NOPASSWD: /bin/cat /etc/hosts
distiller ALL=(ALL) NOPASSWD: /bin/sh -c echo * > /etc/hostname

# System configuration file management
distiller ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/avahi/avahi-daemon.conf
distiller ALL=(ALL) NOPASSWD: /bin/tee /etc/avahi/avahi-daemon.conf

# LED control via sysfs (requires sudo for write operations)
distiller ALL=(ALL) NOPASSWD: /usr/bin/tee /sys/class/leds/*
distiller ALL=(ALL) NOPASSWD: /bin/tee /sys/class/leds/*

# Audio hardware control (microphone gain and speaker volume)
distiller ALL=(ALL) NOPASSWD: /usr/bin/tee /sys/devices/platform/axi/*/i2c/*/input_gain
distiller ALL=(ALL) NOPASSWD: /usr/bin/tee /sys/devices/platform/axi/*/i2c/*/volume_level
distiller ALL=(ALL) NOPASSWD: /bin/tee /sys/devices/platform/axi/*/i2c/*/input_gain
distiller ALL=(ALL) NOPASSWD: /bin/tee /sys/devices/platform/axi/*/i2c/*/volume_level
distiller ALL=(ALL) NOPASSWD: /usr/bin/cat /sys/devices/platform/axi/*/i2c/*/input_gain
distiller ALL=(ALL) NOPASSWD: /usr/bin/cat /sys/devices/platform/axi/*/i2c/*/volume_level
distiller ALL=(ALL) NOPASSWD: /bin/cat /sys/devices/platform/axi/*/i2c/*/input_gain
distiller ALL=(ALL) NOPASSWD: /bin/cat /sys/devices/platform/axi/*/i2c/*/volume_level

# Text-to-speech Piper binary execution
distiller ALL=(ALL) NOPASSWD: /usr/local/bin/piper
distiller ALL=(ALL) NOPASSWD: /opt/*/piper

# Input device access for hardware key monitoring
distiller ALL=(ALL) NOPASSWD: /bin/chown distiller /dev/input/event*
distiller ALL=(ALL) NOPASSWD: /bin/chmod 664 /dev/input/event*

# UART device access for power management
distiller ALL=(ALL) NOPASSWD: /bin/chown distiller /dev/pamir-sam
distiller ALL=(ALL) NOPASSWD: /bin/chmod 664 /dev/pamir-sam
distiller ALL=(ALL) NOPASSWD: /bin/chown distiller /dev/serial*
distiller ALL=(ALL) NOPASSWD: /bin/chmod 664 /dev/serial*

# Allow distiller user to manage power operations
distiller ALL=(ALL) NOPASSWD: /sbin/shutdown
distiller ALL=(ALL) NOPASSWD: /sbin/reboot
distiller ALL=(ALL) NOPASSWD: /usr/bin/systemctl poweroff
distiller ALL=(ALL) NOPASSWD: /usr/bin/systemctl reboot

# Allow distiller user to manage GPIO and hardware interfaces
distiller ALL=(ALL) NOPASSWD: /usr/bin/gpio
distiller ALL=(ALL) NOPASSWD: /bin/chown /dev/gpiomem
distiller ALL=(ALL) NOPASSWD: /bin/chmod 666 /dev/gpiomem

# Allow distiller user to manage audio devices and ALSA
distiller ALL=(ALL) NOPASSWD: /usr/bin/amixer
distiller ALL=(ALL) NOPASSWD: /usr/bin/alsamixer

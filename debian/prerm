#!/bin/bash

# Pre-removal script for distiller-cm5-python
# This script performs cleanup before package removal

set -e

# Package configuration
PACKAGE_NAME="distiller-cm5-python"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

echo_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

echo_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

echo_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to perform cleanup
cleanup_processes() {
    echo_status "Cleaning up any remaining processes..."
    
    # More specific process targeting to avoid killing unrelated processes
    # Only target processes running from the specific installation directory
    if pgrep -f "/opt/distiller-cm5-python" >/dev/null 2>&1; then
        echo_status "Found running processes, terminating gracefully..."
        pkill -TERM -f "/opt/distiller-cm5-python" 2>/dev/null || true
        
        # Wait for graceful termination
        sleep 3
        
        # Force kill if still running
        if pgrep -f "/opt/distiller-cm5-python" >/dev/null 2>&1; then
            echo_status "Forcing termination of remaining processes..."
            pkill -KILL -f "/opt/distiller-cm5-python" 2>/dev/null || true
        fi
    fi
    
    echo_success "Process cleanup completed."
}

# Function to display removal information
display_removal_info() {
    echo ""
    echo_status "Distiller CM5 Python is being removed..."
    echo ""
    echo_status "The following will be preserved:"
    echo_status "  - Log files in /var/log/distiller-cm5-python/"
    echo_status "  - Configuration files in /etc/distiller-cm5-python/"
    echo_status "  - System user 'distiller' (if created by this package)"
    echo ""
    echo_status "To completely remove all data, run:"
    echo_status "  sudo apt purge distiller-cm5-python"
    echo ""
}

# Main removal sequence
main() {
    echo_status "Starting pre-removal cleanup for $PACKAGE_NAME..."
    
    # Determine the removal action
    case "$1" in
        remove)
            echo_status "Package is being removed (configuration files will be preserved)."
            cleanup_processes
            display_removal_info
            ;;
        purge)
            echo_status "Package is being purged (all files will be removed)."
            cleanup_processes
            ;;
        upgrade|failed-upgrade)
            echo_status "Package is being upgraded."
            ;;
        *)
            echo_status "Unknown removal action: $1"
            cleanup_processes
            ;;
    esac
    
    echo_success "Pre-removal cleanup completed successfully."
}

# Execute main function
main "$@"

exit 0

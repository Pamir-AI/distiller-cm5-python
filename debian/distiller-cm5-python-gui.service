[Unit]
Description=Distiller CM5 Python GUI Assistant
Documentation=https://github.com/pamir-ai/distiller-cm5-python
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=root
Group=root
Environment=PYTHONPATH=/opt/distiller-cm5-sdk/src:/opt/distiller-cm5-python
Environment=LD_LIBRARY_PATH=/opt/distiller-cm5-sdk/lib
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/opt/distiller-cm5-python
ExecStartPre=/bin/bash -c 'cd /opt/distiller-cm5-python && if command -v uv >/dev/null 2>&1; then uv sync --quiet 2>/dev/null || true; elif [ -f "/usr/local/bin/uv" ]; then /usr/local/bin/uv sync --quiet 2>/dev/null || true; fi'
ExecStartPre=/bin/sleep 5
ExecStart=/opt/distiller-cm5-python/.venv/bin/python /opt/distiller-cm5-python/main.py --gui
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=distiller-cm5-python-gui
# Security settings (relaxed for hardware access)
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=false
ProtectHome=false
PrivateDevices=false
DevicePolicy=open
SupplementaryGroups=netdev gpio spi dialout audio i2c
# Grant hostname management capabilities
AmbientCapabilities=CAP_SYS_ADMIN
ReadWritePaths=/opt/distiller-cm5-python /var/log/distiller-cm5-python /etc/distiller /sys/class/ /sys/devices/platform /etc/NetworkManager/system-connections /etc/hostname /etc/hosts /etc/avahi
# Automatic restart on failure
RestartKillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=10
[Install]
WantedBy=multi-user.target

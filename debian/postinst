#!/bin/bash

# Post-installation script for distiller-cm5-python
# This script sets up the system after package installation

set -e

# Package configuration
PACKAGE_NAME="distiller-cm5-python"
INSTALL_DIR="/opt/$PACKAGE_NAME"
LOG_DIR="/var/log/$PACKAGE_NAME"
CONFIG_DIR="/etc/$PACKAGE_NAME"
VENV_DIR="$INSTALL_DIR/.venv"
DISTILLER_USER="distiller"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

echo_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

echo_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

echo_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to create system user
create_system_user() {
    echo_status "Creating system user '$DISTILLER_USER'..."
    
    if ! id "$DISTILLER_USER" &>/dev/null; then
        useradd --system --create-home --home-dir "$INSTALL_DIR" \
                --shell /bin/bash --comment "Distiller CM5 System User" \
                --user-group "$DISTILLER_USER"
        
        # Add user to required groups for hardware and network access
        usermod -a -G netdev,gpio,spi,dialout,audio "$DISTILLER_USER" 2>/dev/null || true
        
        echo_success "System user '$DISTILLER_USER' created successfully."
    else
        echo_status "System user '$DISTILLER_USER' already exists."
        
        # Ensure user is in required groups for WiFi service support
        usermod -a -G netdev,gpio,spi,dialout,audio "$DISTILLER_USER" 2>/dev/null || true
    fi
}

# Function to install uv package manager
install_uv() {
    echo_status "Checking uv package manager..."
    
    # Check multiple possible locations for uv
    UV_PATHS=(
        "/usr/local/bin/uv"
        "/root/.local/bin/uv"
        "/home/$DISTILLER_USER/.local/bin/uv"
        "$(which uv 2>/dev/null || echo '')"
    )
    
    UV_FOUND=""
    for uv_path in "${UV_PATHS[@]}"; do
        if [ -n "$uv_path" ] && [ -x "$uv_path" ]; then
            UV_FOUND="$uv_path"
            break
        fi
    done
    
    if [ -n "$UV_FOUND" ]; then
        echo_status "uv package manager found at: $UV_FOUND"
        
        # Ensure it's available system-wide
        if [ "$UV_FOUND" != "/usr/local/bin/uv" ] && [ ! -x "/usr/local/bin/uv" ]; then
            cp "$UV_FOUND" /usr/local/bin/uv
            chmod +x /usr/local/bin/uv
            echo_success "uv made available system-wide."
        fi
    else
        echo_status "Installing uv package manager..."
        # Install uv using the official installer
        curl -LsSf https://astral.sh/uv/install.sh | sh
        
        # Make uv available system-wide
        if [ -f "$HOME/.cargo/bin/uv" ]; then
            cp "$HOME/.cargo/bin/uv" /usr/local/bin/uv
            chmod +x /usr/local/bin/uv
        elif [ -f "/root/.local/bin/uv" ]; then
            cp "/root/.local/bin/uv" /usr/local/bin/uv
            chmod +x /usr/local/bin/uv
        fi
        
        echo_success "uv package manager installed successfully."
    fi
}

# Function to setup Python environment
setup_python_environment() {
    echo_status "Setting up Python virtual environment..."
    
    cd "$INSTALL_DIR"
    
    # Set CMAKE arguments for ARM64 compilation without problematic optimizations
    export CMAKE_ARGS="-DGGML_NATIVE=OFF -DCMAKE_CXX_FLAGS=-mcpu=cortex-a76 -DCMAKE_C_FLAGS=-mcpu=cortex-a76"
    export CC=gcc
    export CXX=g++
    
    # Create virtual environment and install dependencies using uv sync
    echo_status "Installing Python dependencies..."
    /usr/local/bin/uv sync --python python3.11
    
    # Verify virtual environment was created
    if [ ! -d "$VENV_DIR" ]; then
        echo_error "Virtual environment creation failed!"
        return 1
    fi
    
    echo_success "Python dependencies installed successfully."
}

# Function to setup directories and permissions
setup_directories() {
    echo_status "Setting up directories and permissions..."
    
    # Create log directory
    mkdir -p "$LOG_DIR"
    chown "$DISTILLER_USER:$DISTILLER_USER" "$LOG_DIR"
    chmod 755 "$LOG_DIR"
    
    # Create config directory for application
    mkdir -p "$CONFIG_DIR"
    chown root:root "$CONFIG_DIR"
    chmod 755 "$CONFIG_DIR"
    
    # Create WiFi service config directory (required by DeviceConfigManager)
    WIFI_CONFIG_DIR="/etc/distiller"
    mkdir -p "$WIFI_CONFIG_DIR"
    chown "$DISTILLER_USER:$DISTILLER_USER" "$WIFI_CONFIG_DIR"
    chmod 755 "$WIFI_CONFIG_DIR"
    
    # Set ownership of installation directory
    chown -R "$DISTILLER_USER:$DISTILLER_USER" "$INSTALL_DIR"
    
    # Set permissions for wrapper scripts
    chmod +x /usr/local/bin/distiller-cm5-python-cli
    chmod +x /usr/local/bin/distiller-cm5-python-gui
    
    echo_success "Directories and permissions configured."
}

# Function to configure WiFi service permissions
configure_wifi_service_permissions() {
    echo_status "Configuring WiFi service permissions..."
    
    # Create PolicyKit rules for NetworkManager D-Bus access
    echo_status "Creating PolicyKit rules for NetworkManager D-Bus access..."
    mkdir -p /etc/polkit-1/rules.d
    cat >/etc/polkit-1/rules.d/50-distiller-networkmanager.rules <<EOF
/* Allow distiller user to manage NetworkManager without authentication */
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
         action.id == "org.freedesktop.NetworkManager.settings.modify.own" ||
         action.id == "org.freedesktop.NetworkManager.network-control" ||
         action.id == "org.freedesktop.NetworkManager.wifi.share.protected" ||
         action.id == "org.freedesktop.NetworkManager.wifi.share.open" ||
         action.id == "org.freedesktop.hostname1.set-static-hostname" ||
         action.id == "org.freedesktop.NetworkManager.settings.modify.hostname") &&
        subject.user == "distiller") {
        return polkit.Result.YES;
    }
});

/* Allow distiller user to control system services related to networking */
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.systemd1.manage-units" ||
         action.id == "org.freedesktop.systemd1.reload-daemon") &&
        subject.user == "distiller") {
        return polkit.Result.YES;
    }
});
EOF
    chmod 644 /etc/polkit-1/rules.d/50-distiller-networkmanager.rules
    
    # Update udev rules for enhanced hardware access
    echo_status "Updating udev rules for WiFi service hardware access..."
    UDEV_RULES_FILE="/etc/udev/rules.d/99-pamir.rules"
    
    # Check if the file exists and add WiFi-specific rules if not present
    if [ -f "$UDEV_RULES_FILE" ]; then
        # Add WiFi service specific rules if they don't exist
        if ! grep -q "# WiFi service hardware access" "$UDEV_RULES_FILE"; then
            cat >> "$UDEV_RULES_FILE" <<EOF

# WiFi service hardware access for distiller user
SUBSYSTEM=="gpio", GROUP="gpio", MODE="0664"
SUBSYSTEM=="spidev", GROUP="spi", MODE="0664"
SUBSYSTEM=="tty", ATTRS{idVendor}=="*", GROUP="dialout", MODE="0664"
EOF
        fi
    else
        echo_warning "udev rules file not found. WiFi service hardware access may be limited."
    fi
    
    # Restart polkit to load new rules (if running)
    if systemctl is-active --quiet polkit; then
        echo_status "Restarting polkit to load new rules..."
        systemctl restart polkit 2>/dev/null || true
    fi
    
    echo_success "WiFi service permissions configured."
}

# Function to configure hardware access
configure_hardware_access() {
    echo_status "Configuring hardware access..."
    
    # Set up GPIO access
    if [ -e /dev/gpiomem ]; then
        chown root:gpio /dev/gpiomem
        chmod 660 /dev/gpiomem
        echo_success "GPIO access configured."
    else
        echo_warning "GPIO device not found. This is normal on non-CM5 systems."
    fi
    
    # Set up SPI access
    if [ -e /dev/spidev0.0 ]; then
        chown root:spi /dev/spidev0.0
        chmod 660 /dev/spidev0.0
        echo_success "SPI access configured."
    else
        echo_warning "SPI device not found. This is normal on non-CM5 systems."
    fi
    
    # Set up UART access
    if [ -e /dev/serial0 ]; then
        chown root:dialout /dev/serial0
        chmod 660 /dev/serial0
        echo_success "UART access configured."
    else
        echo_warning "UART device not found. This is normal on non-CM5 systems."
    fi
}

# Function to download LLM models
download_llm_models() {
    echo_status "Checking LLM model files..."
    
    MODEL_DIR="$INSTALL_DIR/distiller_cm5_python/llm_server/models"
    
    # Model 1: Qwen2.5-3B Instruct
    QWEN25_MODEL_FILE="qwen2.5-3b-instruct-q4_k_m.gguf"
    QWEN25_MODEL_PATH="$MODEL_DIR/$QWEN25_MODEL_FILE"
    QWEN25_MODEL_URL="https://huggingface.co/Qwen/Qwen2.5-3B-Instruct-GGUF/resolve/main/qwen2.5-3b-instruct-q4_k_m.gguf"
    
    # Model 2: Qwen3 Medical Expert
    QWEN3_MEDICAL_MODEL_FILE="qwen3-0.6b-medical-expert-q6_k.gguf"
    QWEN3_MEDICAL_MODEL_PATH="$MODEL_DIR/$QWEN3_MEDICAL_MODEL_FILE"
    QWEN3_MEDICAL_MODEL_URL="https://huggingface.co/mradermacher/Qwen3-0.6B-Medical-Expert-i1-GGUF/resolve/main/Qwen3-0.6B-Medical-Expert.i1-Q6_K.gguf"
    
    # Create models directory if it doesn't exist
    mkdir -p "$MODEL_DIR"
    chown "$DISTILLER_USER:$DISTILLER_USER" "$MODEL_DIR"
    
    # Check available disk space (models are ~2GB + ~0.5GB)
    AVAILABLE_SPACE=$(df "$MODEL_DIR" | awk 'NR==2 {print $4}')
    REQUIRED_SPACE=2621440  # 2.5GB in KB for both models
    
    if [ "$AVAILABLE_SPACE" -lt "$REQUIRED_SPACE" ]; then
        echo_error "Insufficient disk space. Need at least 2.5GB free space for both models."
        echo_error "Available: $(($AVAILABLE_SPACE / 1024))MB, Required: $(($REQUIRED_SPACE / 1024))MB"
        return 1
    fi
    
    # Function to download a single model
    download_single_model() {
        local model_name="$1"
        local model_path="$2"
        local model_url="$3"
        local min_size="$4"
        
        if [ ! -f "$model_path" ]; then
            echo_status "$model_name not found at $model_path. Downloading..."
            echo_status "This may take several minutes depending on your internet connection..."
            
            # Download with progress bar and resume capability
            if command -v wget >/dev/null 2>&1; then
                sudo -u "$DISTILLER_USER" wget --progress=bar:force:noscroll --continue \
                    -O "$model_path" "$model_url"
            elif command -v curl >/dev/null 2>&1; then
                sudo -u "$DISTILLER_USER" curl -L --progress-bar --continue-at - \
                    -o "$model_path" "$model_url"
            else
                echo_error "Neither wget nor curl found. Cannot download model files."
                echo_error "Please install wget or curl and run 'dpkg-reconfigure distiller-cm5-python'."
                return 1
            fi
            
            # Verify download completed successfully
            if [ $? -ne 0 ] || [ ! -f "$model_path" ]; then
                echo_error "Failed to download $model_name."
                echo_error "You can manually download it later with:"
                echo_error "  cd $MODEL_DIR"
                echo_error "  wget -O $(basename "$model_path") $model_url"
                return 1
            fi
            
            # Verify file size
            FILE_SIZE=$(stat -c%s "$model_path" 2>/dev/null || echo "0")
            
            if [ "$FILE_SIZE" -lt "$min_size" ]; then
                echo_error "Downloaded $model_name appears to be incomplete (size: $FILE_SIZE bytes)."
                echo_error "Please try running 'dpkg-reconfigure distiller-cm5-python' to re-download."
                rm -f "$model_path"
                return 1
            fi
            
            # Set proper ownership
            chown "$DISTILLER_USER:$DISTILLER_USER" "$model_path"
            chmod 644 "$model_path"
            
            echo_success "$model_name downloaded successfully."
            echo_status "Model size: $(du -h "$model_path" | cut -f1)"
        else
            echo_status "$model_name already exists at $model_path."
            
            # Verify existing file ownership
            chown "$DISTILLER_USER:$DISTILLER_USER" "$model_path"
            chmod 644 "$model_path"
            
            echo_status "Model size: $(du -h "$model_path" | cut -f1)"
        fi
    }
    
    # Download Qwen2.5-3B model (~2GB)
    download_single_model "Qwen2.5-3B model" "$QWEN25_MODEL_PATH" "$QWEN25_MODEL_URL" 1073741824
    
    # Download Qwen3 Medical Expert model (~0.5GB)
    download_single_model "Qwen3 Medical Expert model" "$QWEN3_MEDICAL_MODEL_PATH" "$QWEN3_MEDICAL_MODEL_URL" 268435456
    
    echo_success "All LLM models processed successfully."
}

# Function to configure udev rules
configure_udev_rules() {
    echo_status "Configuring udev rules for hardware access..."
    
    UDEV_RULES_FILE="/etc/udev/rules.d/99-pamir.rules"
    
    if [ -f "$UDEV_RULES_FILE" ]; then
        # Reload udev rules to pick up new rules
        echo_status "Reloading udev rules..."
        udevadm control --reload-rules
        
        # Trigger udev for existing devices that match our rules
        echo_status "Applying udev rules to existing devices..."
        udevadm trigger --name-match=pamir-sam 2>/dev/null || true
        udevadm trigger --subsystem-match=gpio 2>/dev/null || true
        udevadm trigger --subsystem-match=spi 2>/dev/null || true
        udevadm trigger --subsystem-match=sound 2>/dev/null || true
        
        # Wait for udev to settle
        udevadm settle
        
        echo_success "udev rules configured and applied."
        echo_status "Hardware devices will use proper permissions when connected."
    else
        echo_warning "udev rules file not found at $UDEV_RULES_FILE"
        echo_warning "Hardware access may require manual permission configuration."
    fi
}

# Function to enable systemd service
enable_systemd_service() {
    echo_status "Enabling Distiller CM5 Python GUI service..."
    
    SERVICE_NAME="distiller-cm5-python-gui.service"
    
    # Reload systemd daemon to pick up new service file
    if systemctl --version >/dev/null 2>&1; then
        echo_status "Reloading systemd daemon..."
        systemctl daemon-reload
        
        # Enable the service to start on boot
        echo_status "Enabling $SERVICE_NAME to start on boot..."
        systemctl enable "$SERVICE_NAME"
        
        # Check if we're in a chroot environment (during package build/installation)
        if [ -n "$DEBIAN_FRONTEND" ] || [ ! -d "/proc/1" ] || [ "$(stat -c %d:%i /)" != "$(stat -c %d:%i /proc/1/root/.)" ]; then
            echo_status "Detected package installation environment - service will start on next boot."
        else
            # We're on a live system, start the service immediately
            echo_status "Starting $SERVICE_NAME immediately..."
            systemctl start "$SERVICE_NAME" || {
                echo_warning "Failed to start service immediately. It will start on next boot."
            }
        fi
        
        echo_success "Systemd service configuration completed."
    else
        echo_warning "systemctl not available. Service will need to be enabled manually."
    fi
}

# Function to display post-installation information
display_post_install_info() {
    echo ""
    echo_success "Distiller CM5 Python installation completed successfully!"
    echo ""
    echo_status "Available commands:"
    echo_status "  distiller-cm5-python-cli    - Run in CLI mode"
    echo_status "  distiller-cm5-python-gui    - Run in GUI mode"
    echo ""
    echo_status "Configuration directory: $CONFIG_DIR"
    echo_status "WiFi service config directory: /etc/distiller"
    echo_status "Log directory: $LOG_DIR"
    echo_status "Installation directory: $INSTALL_DIR"
    echo_status "LLM models directory: $INSTALL_DIR/distiller_cm5_python/llm_server/models"
    echo ""
    echo_status "Hardware configuration:"
    echo_status "  udev rules: /etc/udev/rules.d/99-pamir.rules"
    echo_status "  Hardware devices configured for distiller user access"
    echo_status "  PolicyKit rules: /etc/polkit-1/rules.d/50-distiller-networkmanager.rules"
    echo_status "  WiFi service permissions configured for NetworkManager access"
    echo ""
    echo_status "Note: If model downloads failed during installation, you can:"
    echo_status "  sudo dpkg-reconfigure distiller-cm5-python"
    echo_status "  Or manually download models to: $INSTALL_DIR/distiller_cm5_python/llm_server/models"
    echo ""
    echo_status "Service management:"
    echo_status "  systemctl status distiller-cm5-python-gui   - Check service status"
    echo_status "  systemctl restart distiller-cm5-python-gui  - Restart service"
    echo_status "  systemctl stop distiller-cm5-python-gui     - Stop service"
    echo_status "  systemctl disable distiller-cm5-python-gui  - Disable auto-start"
    echo_status "  journalctl -u distiller-cm5-python-gui -f   - View service logs"
    echo ""
    echo_status "For more information, see the documentation at:"
    echo_status "  https://github.com/pamir-ai/distiller-cm5-python"
    echo ""
}

# Main installation sequence
main() {
    echo_status "Starting post-installation configuration for $PACKAGE_NAME..."
    
    # Check if we're on the right architecture
    if [ "$(uname -m)" != "aarch64" ]; then
        echo_warning "This package is designed for ARM64 architecture (CM5 platform)."
        echo_warning "Some features may not work correctly on other architectures."
    fi
    
    # Run installation steps
    create_system_user
    install_uv
    setup_python_environment
    setup_directories
    download_llm_models
    configure_hardware_access
    configure_wifi_service_permissions
    configure_udev_rules
    enable_systemd_service
    display_post_install_info
    
    echo_success "Post-installation configuration completed successfully."
}

# Execute main function
main "$@"

exit 0
